<Project Sdk="Microsoft.NET.Sdk">
    <!--
    Imports hollow knight path properties only if present in order to allow CI builds. The file should be gitignored.
    -->
    <Import Condition="Exists('HollowKnightPath.props')" Project="HollowKnightPath.props"/>
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <EnableNETAnalyzers>True</EnableNETAnalyzers>
        <AnalysisMode>recommended</AnalysisMode>
        <!-- Ignore warning about processor architecture mismatch with PlayMaker ConditionalExpression -->
        <NoWarn>$(NoWarn);MSB3270</NoWarn>

        <RestorePackagesWithLockFile>True</RestorePackagesWithLockFile>
        <RestoreLockedMode Condition="'$(CI)' == 'true'">True</RestoreLockedMode>

        <!-- Shortens and anonymizes paths in debug symbols relative to the project directory. Breakpoints will not work, however. -->
        <PathMap Condition="'$(Configuration)' == 'Release'">$(MSBuildProjectDirectory)=/</PathMap>

        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <RepositoryUrl>https://github.com/jakobhellermann/silksongmod-MapWarp</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.27.0" PrivateAssets="all"/>
        <PackageReference
                Include="UnityEngine.Modules"
                Version="6000.0.50"
                IncludeAssets="compile"
                ExcludeAssets="$(ExcludeAssetsIfLocalReference)"
                Condition="!Exists('$(ManagedDir)')"
        />
        <!-- TODO: remove condition when gamelibs is created -->
        <PackageReference
                Include="HollowKnight.GameLibs"
                Version="*-*"
                PrivateAssets="all"
                ExcludeAssets="$(ExcludeAssetsIfLocalReference)"
                Condition="!Exists('$(ManagedDir)')"
        />
    </ItemGroup>

    <PropertyGroup Condition="Exists('$(ManagedDir)')">
        <ExcludeAssetsIfLocalReference>compile</ExcludeAssetsIfLocalReference>
    </PropertyGroup>
    <Target Name="ValidateManagedDir" BeforeTargets="BeforeBuild">
        <Error Condition="'$(ManagedDir)' != '' And !Exists('$(ManagedDir)')" Text="ManagedDir '$(ManagedDir)' does not exist."/>
    </Target>
    <ItemGroup Condition="Exists('$(ManagedDir)')">
        <LocalReferences
                Include="$(ManagedDir)/*.dll"
                Exclude="$(ManagedDir)/Mono*.dll;$(ManagedDir)/netstandard.dll;$(ManagedDir)/System*.dll;$(ManagedDir)/mscorlib.dll;$(ManagedDir)/Silksong.*.dll"
        />
        <Reference Include="@(LocalReferences)" Private="false"/>
        <!-- TODO: fix 4.0.3.0 mapi 4.0.2.0 netstandard2.1 ambiguity -->
        <Reference Include="$(ManagedDir)/System.ValueTuple.dll" Private="false"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="True" PackagePath="README.md"/>
        <!-- Offline-generated map data for every room (tools/extract_respawns.sh). -->
        <EmbeddedResource Include="data/mapwarp_respawns.json"/>
        <EmbeddedResource Include="data/mapwarp_scene_sizes.json"/>
    </ItemGroup>

    <Target Name="CopyMod" AfterTargets="PostBuildEvent">
        <ItemGroup>
            <Binaries Include="$(TargetPath)"/>
            <Binaries Include="$(TargetDir)/$(TargetName).pdb"/>
        </ItemGroup>

        <Copy
                SourceFiles="@(Binaries)"
                DestinationFolder="$(ModsDir)/$(AssemblyTitle)"
                Condition="'$(ModsDir)' != '' And Exists('$(ModsDir)')"
        />
    </Target>
</Project>
