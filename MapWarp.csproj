<Project Sdk="Microsoft.NET.Sdk">
    <!--
    Imports hollow knight path properties only if present in order to allow CI builds. The file should be gitignored.
    -->
    <Import Condition="Exists('HollowKnightPath.props')" Project="HollowKnightPath.props"/>
    <Import Project="HollowKnight.TargetFrameworks.props"/>

    <PropertyGroup>
        <!-- One assembly per game version; see HollowKnight.TargetFrameworks.props -->
        <TargetFrameworks>hk1512620;hk1578;hk1432;hk1315;hk1221</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <EnableNETAnalyzers>True</EnableNETAnalyzers>
        <AnalysisMode>recommended</AnalysisMode>
        <!-- Ignore warning about processor architecture mismatch with PlayMaker ConditionalExpression -->
        <NoWarn>$(NoWarn);MSB3270</NoWarn>

        <!-- Puts dependencies into $(TargetDir), where the Repack target sees them -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <RestorePackagesWithLockFile>True</RestorePackagesWithLockFile>
        <RestoreLockedMode Condition="'$(CI)' == 'true'">True</RestoreLockedMode>

        <!-- Shortens and anonymizes paths in debug symbols relative to the project directory. Breakpoints will not work, however. -->
        <PathMap Condition="'$(Configuration)' == 'Release'">$(MSBuildProjectDirectory)=/</PathMap>

        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/jakobhellermann/silksongmod-MapWarp</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.27.0" PrivateAssets="all"/>
    </ItemGroup>

    <!-- 1.2.2.1's API ships no MonoMod. 21.4.29.1 is what the API ships from 1.3.1.5 on. -->
    <ItemGroup Condition="'$(RepackDependencies)' == 'true'">
        <PackageReference Include="MonoMod.RuntimeDetour" Version="[21.4.29.1]" PrivateAssets="all"/>
        <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.46" PrivateAssets="all"/>
    </ItemGroup>

    <PropertyGroup Condition="Exists('$(ManagedDir)')">
        <ExcludeAssetsIfLocalReference>compile</ExcludeAssetsIfLocalReference>
    </PropertyGroup>
    <Target Name="ValidateManagedDir" BeforeTargets="BeforeBuild">
        <Error Condition="'$(ManagedDir)' != '' And !Exists('$(ManagedDir)')" Text="ManagedDir '$(ManagedDir)' does not exist."/>
    </Target>
    <ItemGroup Condition="Exists('$(ManagedDir)')">
        <LocalReferences Include="Assembly-CSharp;PlayMaker"/>
        <LocalReferences Include="MonoMod.RuntimeDetour;MonoMod.Utils;Mono.Cecil" Condition="'$(RepackDependencies)' != 'true'"/>
        <LocalReferences Include="UnityEngine;UnityEngine.UI"/>
        <LocalReferences
                Include="UnityEngine.CoreModule;UnityEngine.IMGUIModule;UnityEngine.Physics2DModule;UnityEngine.TextRenderingModule;UnityEngine.UIModule"
                Condition="'$(NoUnityModules)' != 'true'"
        />
        <!-- On 1.4.3.2 Input is still part of UnityEngine.CoreModule and there is no separate module. -->
        <LocalReferences Include="UnityEngine.InputLegacyModule" Condition="'$(NoUnityModules)' != 'true' And '$(TargetFramework)' != 'hk1432'"/>
        <!-- Only shipped from 1.5.12620 on. System.ValueTuple: the game has 4.0.3.0, the netstandard2.1 reference pack 4.0.2.0, so MSB3277 fires without it. -->
        <LocalReferences Include="TeamCherry.TK2D;MonoMod.Backports;System.ValueTuple" Condition="'$(TargetFramework)' == 'hk1512620'"/>
        <Reference Include="@(LocalReferences->'$(ManagedDir)/%(Identity).dll')" Private="false"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="True" PackagePath="README.md"/>
        <!-- Offline-generated map data for every room (tools/extract_respawns.sh). -->
        <EmbeddedResource Include="data/mapwarp_respawns.bin"/>
    </ItemGroup>

    <Target Name="Repack" AfterTargets="PostBuildEvent" BeforeTargets="CopyMod" Condition="'$(RepackDependencies)' == 'true'">
        <ItemGroup>
            <RepackInput Include="$(TargetPath)"/>
            <RepackInput Include="$(TargetDir)MonoMod.*.dll;$(TargetDir)Mono.Cecil*.dll"/>
            <RepackSearchDir Include="@(ReferencePath->'%(RootDir)%(Directory)')"/>
        </ItemGroup>
        <ILRepack InputAssemblies="@(RepackInput)" OutputFile="$(TargetPath)" LibraryPath="@(RepackSearchDir->Distinct())"
                  TargetKind="Dll" Internalize="true" Parallel="false"/>
        <Delete Files="@(RepackInput)" Condition="'%(Identity)' != '$(TargetPath)'"/>
    </Target>

    <Target Name="CopyMod" AfterTargets="PostBuildEvent" Condition="'$(ModsDir)' != '' And Exists('$(ModsDir)')">
        <PropertyGroup>
            <ModInstallDir Condition="'$(ModsLayout)' == 'flat'">$(ModsDir)</ModInstallDir>
            <ModInstallDir Condition="'$(ModsLayout)' == 'subdirectory'">$(ModsDir)/$(AssemblyTitle)</ModInstallDir>
        </PropertyGroup>
        <Error Condition="'$(ModInstallDir)' == ''" Text="No Mods layout known for $(TargetFramework)."/>
        <Copy SourceFiles="$(TargetPath);$(TargetDir)/$(TargetName).pdb" DestinationFolder="$(ModInstallDir)"/>
    </Target>
</Project>
