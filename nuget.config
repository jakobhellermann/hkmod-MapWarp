<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear/>
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3"/>
        <add key="nuget.jjakobh.me" value="https://nuget.jjakobh.me/v3/index.json" protocolVersion="3"/>
    </packageSources>
    <packageSourceMapping>
        <packageSource key="nuget.org">
            <package pattern="*"/>
        </packageSource>
        <packageSource key="nuget.jjakobh.me">
            <package pattern="HollowKnight.GameLibs"/>
        </packageSource>
    </packageSourceMapping>
</configuration>
