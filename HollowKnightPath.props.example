<Project>
    <PropertyGroup>
		<!-- Optional. If set, only build one version -->
        <TargetFramework>hk1512620</TargetFramework>
        <GameBaseDir>/path/to/downpatches</GameBaseDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'hk1221'">
        <GameDir>$(GameBaseDir)/Hollow Knight-1.2.2.1</GameDir>
    </PropertyGroup>
    <PropertyGroup Condition="'$(TargetFramework)' == 'hk1315'">
        <GameDir>$(GameBaseDir)/Hollow Knight-1.3.1.5</GameDir>
    </PropertyGroup>
    <PropertyGroup Condition="'$(TargetFramework)' == 'hk1432'">
        <GameDir>$(GameBaseDir)/Hollow Knight-1.4.3.2</GameDir>
    </PropertyGroup>
    <PropertyGroup Condition="'$(TargetFramework)' == 'hk1578'">
        <GameDir>$(GameBaseDir)/Hollow Knight-1.5.78.11833</GameDir>
    </PropertyGroup>
    <PropertyGroup Condition="'$(TargetFramework)' == 'hk1512620'">
        <GameDir>$(GameBaseDir)/Hollow Knight-1.5.12620</GameDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GameDir)' != ''">
		<!-- Optional. Lets you browse decompiled sources in the IDE -->
        <ManagedDir>$(GameDir)/hollow_knight.app/Contents/Resources/Data/Managed</ManagedDir>
		<!-- Optional. When set, install mod on build -->
        <ModsDir>$(ManagedDir)/Mods</ModsDir>
    </PropertyGroup>
</Project>
